{
  "schema_version": 1,
  "id": "stack-questions",
  "questions": [
    {
      "id": "product_type",
      "text": "¿Qué tipo de producto es?",
      "options": [
        "web-app",
        "landing-or-portfolio",
        "documentation",
        "api-or-agent",
        "other"
      ]
    },
    {
      "id": "team_languages",
      "text": "¿Qué lenguajes domina el equipo?",
      "options": [
        "python",
        "typescript",
        "go",
        "java",
        "kotlin",
        "csharp",
        "php",
        "ruby",
        "rust",
        "other"
      ]
    },
    {
      "id": "load_latency",
      "text": "¿Qué carga y qué latencia se esperan (usuarios simultáneos, peticiones por segundo, tiempo de respuesta aceptable)?",
      "options": [
        "low",
        "moderate",
        "high"
      ]
    },
    {
      "id": "infra_budget",
      "text": "¿Cuál es el presupuesto de infraestructura?",
      "options": [
        "minimal",
        "moderate",
        "flexible"
      ]
    },
    {
      "id": "realtime",
      "text": "¿Necesita tiempo real (chat, colaboración, notificaciones en vivo)?",
      "options": [
        "yes",
        "no"
      ]
    },
    {
      "id": "compute_ai",
      "text": "¿Hay cómputo intensivo o funcionalidades de IA/ML?",
      "options": [
        "yes",
        "no"
      ]
    },
    {
      "id": "maintenance_horizon",
      "text": "¿Cuál es el horizonte de mantenimiento?",
      "options": [
        "prototype",
        "one-to-two-years",
        "five-years-or-more"
      ]
    },
    {
      "id": "org_constraints",
      "text": "¿Qué restricciones impone la organización (lenguajes aprobados, nube, licencias, cumplimiento)?",
      "required": false
    }
  ]
}
