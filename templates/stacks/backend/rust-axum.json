{
  "schema_version": 1,
  "id": "rust-axum",
  "component": "backend",
  "covers": [
    "backend"
  ],
  "summary": "Servicios HTTP en Rust con Axum y Tokio: sin recolector de basura y con tipado estático fuerte.",
  "language": "Rust",
  "fits": [
    "servicios con requisitos estrictos de latencia y memoria",
    "cómputo intensivo detrás de una API",
    "equipos con experiencia en Rust"
  ],
  "avoid_if": [
    "el plazo es corto y el equipo no conoce Rust",
    "se busca un framework con ORM y administración incluidos",
    "un sitio de documentación es el objetivo"
  ],
  "suggested_services": [
    "database:postgresql"
  ],
  "package_manager": "cargo",
  "default_test_command": [
    "cargo",
    "test"
  ],
  "test_commands": {
    "root": [
      "cargo",
      "test"
    ],
    "subdir": [
      "cargo",
      "test",
      "--manifest-path",
      "{root}/Cargo.toml"
    ]
  },
  "gitignore": [
    "target/",
    ".env"
  ],
  "architecture": "rust-axum",
  "factors": {
    "performance": "alto: compilado a código nativo, sin recolector de basura",
    "memory_footprint": "bajo: la memoria se gestiona con propiedad (ownership) y no hay recolector de basura",
    "cold_start": "bajo: binario nativo sin runtime externo",
    "concurrency_model": "async con Tokio, un runtime con planificador multihilo de robo de trabajo",
    "typing": "tipado estático con propiedad y préstamos verificados por el compilador",
    "productivity": "bajo a medio: el compilador exige más diseño inicial; menos convenciones listas que en frameworks completos",
    "learning_curve": "alta: propiedad, préstamos, tiempos de vida y async",
    "maintainability": "alta: visibilidad privada por defecto, pub(crate) y workspaces para separar crates",
    "ecosystem_maturity": "medio: Axum está en versiones 0.x (0.8.9) y el ecosistema de crates crece rápido",
    "hiring_pool": "bajo a medio: Rust lo usa el 14,5 % y Axum el 2,7 % de los desarrolladores profesionales (Stack Overflow 2025)",
    "hosting_fit": "containers, PaaS"
  },
  "sources": {
    "performance": [
      "https://doc.rust-lang.org/book/"
    ],
    "memory_footprint": [
      "https://doc.rust-lang.org/book/ch04-01-what-is-ownership.html"
    ],
    "cold_start": [
      "https://doc.rust-lang.org/book/"
    ],
    "concurrency_model": [
      "https://tokio.rs/"
    ],
    "typing": [
      "https://doc.rust-lang.org/book/"
    ],
    "productivity": [
      "https://docs.rs/axum/latest/axum/"
    ],
    "learning_curve": [
      "https://doc.rust-lang.org/book/ch04-01-what-is-ownership.html"
    ],
    "maintainability": [
      "https://doc.rust-lang.org/reference/visibility-and-privacy.html",
      "https://doc.rust-lang.org/cargo/reference/workspaces.html"
    ],
    "ecosystem_maturity": [
      "https://github.com/tokio-rs/axum/blob/main/axum/CHANGELOG.md"
    ],
    "hiring_pool": [
      "https://survey.stackoverflow.co/2025/technology"
    ],
    "hosting_fit": [
      "https://docs.rs/axum/latest/axum/"
    ]
  },
  "supported_services": {
    "postgresql": {
      "driver": "sqlx",
      "url": "postgresql://app:app_local_only@127.0.0.1:5432/app"
    },
    "mysql": {
      "driver": "sqlx",
      "url": "mysql://app:app_local_only@127.0.0.1:3306/app"
    },
    "mongodb": {
      "driver": "mongodb",
      "url": "mongodb://app:app_local_only@127.0.0.1:27017/app?authSource=admin"
    },
    "redis": {
      "driver": "redis",
      "url": "redis://127.0.0.1:6379/0"
    },
    "valkey": {
      "driver": "redis",
      "url": "redis://127.0.0.1:6379/0"
    },
    "rabbitmq": {
      "driver": "lapin",
      "url": "amqp://app:app_local_only@127.0.0.1:5672/"
    },
    "kafka": {
      "driver": "rdkafka",
      "url": "localhost:9092"
    }
  },
  "data_access": {
    "default": {
      "relational": "sqlx",
      "document": "mongodb-crate"
    },
    "options": [
      {
        "id": "sqlx",
        "name": "sqlx",
        "kind": "driver",
        "models": [
          "relational"
        ],
        "engines": [
          "postgresql",
          "mysql"
        ],
        "runtimes": [
          "rust"
        ],
        "migrations": {
          "tool": "sqlx-cli",
          "generate": [
            "sqlx",
            "migrate",
            "add",
            "<name>"
          ],
          "apply": [
            "sqlx",
            "migrate",
            "run"
          ]
        },
        "schema_validation": null,
        "notes": "Consultas verificadas al compilar, sin DSL; no es un ORM.",
        "sources": [
          "https://github.com/launchbadge/sqlx",
          "https://raw.githubusercontent.com/launchbadge/sqlx/main/sqlx-cli/README.md"
        ]
      },
      {
        "id": "sea-orm",
        "name": "SeaORM",
        "kind": "orm",
        "models": [
          "relational"
        ],
        "engines": [
          "postgresql",
          "mysql"
        ],
        "runtimes": [
          "rust"
        ],
        "migrations": {
          "tool": "sea-orm-cli",
          "generate": [
            "sea-orm-cli",
            "migrate",
            "generate",
            "<name>"
          ],
          "apply": [
            "sea-orm-cli",
            "migrate",
            "up"
          ]
        },
        "schema_validation": null,
        "notes": "ORM asíncrono y dinámico, construido sobre sqlx (`sea-orm-cli migrate init` crea la carpeta de migraciones).",
        "sources": [
          "https://www.sea-ql.org/SeaORM/docs/index/",
          "https://www.sea-ql.org/SeaORM/docs/install-and-config/database-and-async-runtime/",
          "https://www.sea-ql.org/SeaORM/docs/migration/setting-up-migration/",
          "https://www.sea-ql.org/SeaORM/docs/migration/running-migration/"
        ]
      },
      {
        "id": "diesel",
        "name": "Diesel",
        "kind": "orm",
        "models": [
          "relational"
        ],
        "engines": [
          "postgresql",
          "mysql"
        ],
        "runtimes": [
          "rust"
        ],
        "migrations": {
          "tool": "diesel_cli",
          "generate": [
            "diesel",
            "migration",
            "generate",
            "<name>"
          ],
          "apply": [
            "diesel",
            "migration",
            "run"
          ]
        },
        "schema_validation": null,
        "notes": "ORM y query builder con tipos verificados al compilar.",
        "sources": [
          "https://diesel.rs/",
          "https://diesel.rs/guides/getting-started.html"
        ]
      },
      {
        "id": "mongodb-crate",
        "name": "Crate oficial `mongodb`",
        "kind": "driver",
        "models": [
          "document"
        ],
        "engines": [
          "mongodb"
        ],
        "runtimes": [
          "rust"
        ],
        "migrations": null,
        "schema_validation": "Validación de esquema de MongoDB: reglas `$jsonSchema` en cada colección, declaradas en el repositorio.",
        "notes": "Sin capa de modelos: la forma de cada documento la fija el código y la validación de la colección.",
        "sources": [
          "https://www.mongodb.com/docs/drivers/rust/current/",
          "https://www.mongodb.com/docs/manual/core/schema-validation/"
        ]
      }
    ]
  }
}
