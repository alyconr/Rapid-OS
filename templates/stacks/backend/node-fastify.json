{
  "schema_version": 1,
  "id": "node-fastify",
  "component": "backend",
  "covers": [
    "backend"
  ],
  "summary": "API en TypeScript con Fastify: núcleo pequeño, plugins encapsulados y validación con JSON Schema.",
  "language": "TypeScript",
  "fits": [
    "APIs de alto rendimiento y poca configuración",
    "servicios de agentes de IA en TypeScript (con ai=yes)",
    "equipos que prefieren un núcleo mínimo"
  ],
  "avoid_if": [
    "el equipo quiere una estructura impuesta por el framework",
    "el equipo no usa TypeScript",
    "un sitio de documentación es el objetivo"
  ],
  "suggested_services": [
    "database:postgresql"
  ],
  "package_manager": "pnpm",
  "default_test_command": [
    "pnpm",
    "test"
  ],
  "test_commands": {
    "root": [
      "pnpm",
      "test"
    ],
    "subdir": [
      "pnpm",
      "--dir",
      "{root}",
      "test"
    ]
  },
  "gitignore": [
    "node_modules/",
    "dist/",
    "coverage/",
    ".env"
  ],
  "architecture": "node-fastify",
  "factors": {
    "performance": "medio a alto en E/S: Node.js (V8); la documentación destaca una serialización 2-3 veces más rápida con JSON Schema",
    "memory_footprint": "medio: proceso Node.js con un núcleo pequeño",
    "cold_start": "bajo a medio: la documentación incluye guías para Lambda, Cloud Run y Vercel",
    "concurrency_model": "bucle de eventos de un hilo con E/S asíncrona; worker threads para CPU",
    "typing": "TypeScript soportado con type providers (TypeBox, json-schema-to-ts)",
    "productivity": "medio: ofrece lo esencial y el resto se compone con plugins",
    "learning_curve": "media: plugins, encapsulación y JSON Schema",
    "maintainability": "alta: cada plugin crea su propio ámbito y forma un grafo de dependencias",
    "ecosystem_maturity": "medio: plugins oficiales para PostgreSQL, MySQL, Redis y MongoDB; más joven que Express",
    "hiring_pool": "medio: TypeScript lo usa el 48,8 % de los desarrolladores profesionales y Fastify el 3,1 % (Stack Overflow 2025)",
    "hosting_fit": "containers, PaaS, serverless"
  },
  "sources": {
    "performance": [
      "https://fastify.dev/docs/latest/Guides/Getting-Started/"
    ],
    "memory_footprint": [
      "https://fastify.dev/docs/latest/"
    ],
    "cold_start": [
      "https://fastify.dev/docs/latest/Guides/Serverless/"
    ],
    "concurrency_model": [
      "https://nodejs.org/en/learn/asynchronous-work/event-loop-timers-and-nexttick"
    ],
    "typing": [
      "https://fastify.dev/docs/latest/Reference/TypeScript/"
    ],
    "productivity": [
      "https://fastify.dev/docs/latest/Guides/Getting-Started/"
    ],
    "learning_curve": [
      "https://fastify.dev/docs/latest/Reference/Plugins/"
    ],
    "maintainability": [
      "https://fastify.dev/docs/latest/Reference/Plugins/"
    ],
    "ecosystem_maturity": [
      "https://fastify.dev/docs/latest/Guides/Database/",
      "https://fastify.dev/docs/latest/Reference/LTS/"
    ],
    "hiring_pool": [
      "https://survey.stackoverflow.co/2025/technology"
    ],
    "hosting_fit": [
      "https://fastify.dev/docs/latest/Guides/Serverless/"
    ]
  },
  "supported_services": {
    "postgresql": {
      "driver": "pg",
      "url": "postgresql://app:app_local_only@127.0.0.1:5432/app"
    },
    "mysql": {
      "driver": "mysql2",
      "url": "mysql://app:app_local_only@127.0.0.1:3306/app"
    },
    "mariadb": {
      "driver": "mariadb",
      "url": "mariadb://app:app_local_only@127.0.0.1:3306/app"
    },
    "mongodb": {
      "driver": "mongodb",
      "url": "mongodb://app:app_local_only@127.0.0.1:27017/app?authSource=admin"
    },
    "redis": {
      "driver": "redis",
      "url": "redis://127.0.0.1:6379/0"
    },
    "valkey": {
      "driver": "iovalkey",
      "url": "redis://127.0.0.1:6379/0"
    },
    "rabbitmq": {
      "driver": "amqplib",
      "url": "amqp://app:app_local_only@127.0.0.1:5672/"
    },
    "kafka": {
      "driver": "kafkajs",
      "url": "localhost:9092"
    }
  },
  "data_access": {
    "default": {
      "relational": "drizzle",
      "document": "mongodb-driver"
    },
    "options": [
      {
        "id": "drizzle",
        "name": "Drizzle ORM",
        "kind": "orm",
        "models": [
          "relational"
        ],
        "engines": [
          "postgresql",
          "mysql"
        ],
        "runtimes": [
          "node"
        ],
        "migrations": {
          "tool": "drizzle-kit",
          "generate": [
            "pnpm",
            "drizzle-kit",
            "generate"
          ],
          "apply": [
            "pnpm",
            "drizzle-kit",
            "migrate"
          ]
        },
        "schema_validation": null,
        "notes": "ORM de TypeScript sin motor propio: el esquema es código y drizzle-kit genera migraciones SQL.",
        "sources": [
          "https://orm.drizzle.team/docs/overview",
          "https://orm.drizzle.team/docs/drizzle-kit-generate",
          "https://orm.drizzle.team/docs/drizzle-kit-migrate"
        ]
      },
      {
        "id": "prisma",
        "name": "Prisma ORM 7",
        "kind": "orm",
        "models": [
          "relational"
        ],
        "engines": [
          "postgresql",
          "mysql",
          "mariadb"
        ],
        "runtimes": [
          "node"
        ],
        "migrations": {
          "tool": "prisma migrate",
          "generate": [
            "pnpm",
            "prisma",
            "migrate",
            "dev",
            "--name",
            "<name>"
          ],
          "apply": [
            "pnpm",
            "prisma",
            "migrate",
            "deploy"
          ]
        },
        "schema_validation": null,
        "notes": "Fija Prisma ORM 7: el tag `latest` de npm apunta a la prerelease 8 (8.0.0-rc), que cambia estos comandos por `prisma migration plan` y `prisma db migrate` y aún no da soporte estable a MySQL ni a MariaDB. Prisma 7 tampoco admite MongoDB (usa `mongodb` o Mongoose). `migrate dev` nunca se ejecuta en producción.",
        "sources": [
          "https://www.prisma.io/docs/orm/v7/prisma-migrate/getting-started",
          "https://www.prisma.io/docs/orm/v7/prisma-migrate/workflows/development-and-production",
          "https://www.prisma.io/docs/orm/v7/core-concepts/supported-databases",
          "https://www.prisma.io/docs/orm/coming-from-prisma-orm-7"
        ]
      },
      {
        "id": "kysely",
        "name": "Kysely",
        "kind": "query-builder",
        "models": [
          "relational"
        ],
        "engines": [
          "postgresql",
          "mysql"
        ],
        "runtimes": [
          "node"
        ],
        "migrations": {
          "tool": "kysely-ctl",
          "generate": [
            "pnpm",
            "kysely",
            "migrate",
            "make",
            "<name>"
          ],
          "apply": [
            "pnpm",
            "kysely",
            "migrate",
            "latest"
          ]
        },
        "schema_validation": null,
        "notes": "Query builder de SQL con tipos, no un ORM: las migraciones se escriben a mano y corren con su `Migrator` o con la CLI opcional kysely-ctl (`kysely init` crea su configuración). MariaDB solo tiene dialecto de terceros: fuera.",
        "sources": [
          "https://kysely.dev/docs/intro",
          "https://kysely.dev/docs/migrations",
          "https://kysely.dev/docs/dialects",
          "https://github.com/kysely-org/kysely-ctl"
        ]
      },
      {
        "id": "mongodb-driver",
        "name": "Driver oficial de MongoDB para Node.js",
        "kind": "driver",
        "models": [
          "document"
        ],
        "engines": [
          "mongodb"
        ],
        "runtimes": [
          "node"
        ],
        "migrations": null,
        "schema_validation": "Validación de esquema de MongoDB: reglas `$jsonSchema` en cada colección, declaradas en el repositorio.",
        "notes": "Sin capa de modelos: la forma de cada documento la fija el código y la validación de la colección.",
        "sources": [
          "https://www.mongodb.com/docs/drivers/node/current/",
          "https://www.mongodb.com/docs/manual/core/schema-validation/"
        ]
      },
      {
        "id": "mongoose",
        "name": "Mongoose",
        "kind": "odm",
        "models": [
          "document"
        ],
        "engines": [
          "mongodb"
        ],
        "runtimes": [
          "node"
        ],
        "migrations": null,
        "schema_validation": "Esquemas de Mongoose: los validadores se declaran en cada `SchemaType` y corren en la aplicación.",
        "notes": "Modela cada colección con un esquema.",
        "sources": [
          "https://mongoosejs.com/docs/",
          "https://mongoosejs.com/docs/validation.html"
        ]
      }
    ]
  }
}
