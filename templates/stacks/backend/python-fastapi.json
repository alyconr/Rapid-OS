{
  "schema_version": 1,
  "id": "python-fastapi",
  "component": "backend",
  "covers": [
    "backend"
  ],
  "summary": "API de negocio en Python con FastAPI, Pydantic y SQLAlchemy asíncrono.",
  "language": "Python",
  "fits": [
    "APIs de negocio en Python",
    "agentes de IA y pipelines de datos (con ai=yes)",
    "equipos que ya dominan Python"
  ],
  "avoid_if": [
    "el proyecto no tiene backend ni base de datos",
    "el equipo no usa Python",
    "un sitio de documentación es el objetivo"
  ],
  "suggested_services": [
    "database:postgresql"
  ],
  "package_manager": "uv",
  "default_test_command": [
    "pytest"
  ],
  "test_commands": {
    "root": [
      "uv",
      "run",
      "pytest"
    ],
    "subdir": [
      "uv",
      "run",
      "--directory",
      "{root}",
      "pytest"
    ]
  },
  "gitignore": [
    ".venv/",
    ".ruff_cache/",
    ".mypy_cache/",
    "*.egg-info/",
    ".env"
  ],
  "architecture": "python-fastapi",
  "factors": {
    "performance": "medio: CPython interpretado; ASGI con uvicorn atiende E/S concurrente con async/await",
    "memory_footprint": "medio: un proceso CPython por worker con el intérprete y las librerías cargadas",
    "cold_start": "medio: arranque del intérprete e importación de dependencias",
    "concurrency_model": "ASGI y asyncio (async def para E/S); el GIL de CPython limita el paralelismo de CPU dentro de un proceso",
    "typing": "anotaciones de tipos estándar de Python; Pydantic valida los datos en ejecución",
    "productivity": "alto: validación, serialización y documentación de la API salen de las anotaciones de tipos",
    "learning_curve": "baja a media: Python y anotaciones de tipos; async/await exige entender asyncio",
    "maintainability": "alta con anotaciones de tipos y un APIRouter por módulo",
    "ecosystem_maturity": "alto en datos e IA (Python); FastAPI es más joven que Django",
    "hiring_pool": "alto: Python lo usa el 54,8 % de los desarrolladores profesionales y FastAPI el 15,1 % (Stack Overflow 2025)",
    "hosting_fit": "containers, PaaS"
  },
  "sources": {
    "performance": [
      "https://fastapi.tiangolo.com/",
      "https://fastapi.tiangolo.com/deployment/"
    ],
    "memory_footprint": [
      "https://devguide.python.org/versions/"
    ],
    "cold_start": [
      "https://devguide.python.org/versions/"
    ],
    "concurrency_model": [
      "https://fastapi.tiangolo.com/",
      "https://docs.python.org/3/glossary.html#term-global-interpreter-lock"
    ],
    "typing": [
      "https://fastapi.tiangolo.com/",
      "https://pydantic.dev/docs/validation/latest/get-started/"
    ],
    "productivity": [
      "https://fastapi.tiangolo.com/"
    ],
    "learning_curve": [
      "https://fastapi.tiangolo.com/"
    ],
    "maintainability": [
      "https://fastapi.tiangolo.com/tutorial/bigger-applications/"
    ],
    "ecosystem_maturity": [
      "https://fastapi.tiangolo.com/release-notes/",
      "https://survey.stackoverflow.co/2025/technology"
    ],
    "hiring_pool": [
      "https://survey.stackoverflow.co/2025/technology"
    ],
    "hosting_fit": [
      "https://fastapi.tiangolo.com/deployment/"
    ]
  },
  "supported_services": {
    "postgresql": {
      "driver": "asyncpg",
      "url": "postgresql+asyncpg://app:app_local_only@127.0.0.1:5432/app",
      "orm": "SQLAlchemy 2 (async) + Alembic (migrations)"
    },
    "mysql": {
      "driver": "asyncmy",
      "url": "mysql+asyncmy://app:app_local_only@127.0.0.1:3306/app",
      "orm": "SQLAlchemy 2 (async) + Alembic (migrations)"
    },
    "mariadb": {
      "driver": "asyncmy",
      "url": "mysql+asyncmy://app:app_local_only@127.0.0.1:3306/app",
      "orm": "SQLAlchemy 2 (async) + Alembic (migrations)"
    },
    "mongodb": {
      "driver": "pymongo",
      "url": "mongodb://app:app_local_only@127.0.0.1:27017/app?authSource=admin"
    },
    "redis": {
      "driver": "redis",
      "url": "redis://127.0.0.1:6379/0"
    },
    "valkey": {
      "driver": "valkey",
      "url": "valkey://127.0.0.1:6379/0"
    },
    "rabbitmq": {
      "driver": "aio-pika",
      "url": "amqp://app:app_local_only@127.0.0.1:5672/"
    },
    "kafka": {
      "driver": "aiokafka",
      "url": "localhost:9092"
    }
  },
  "data_access": {
    "default": {
      "relational": "sqlalchemy-async",
      "document": "pymongo-async"
    },
    "options": [
      {
        "id": "sqlalchemy-async",
        "name": "SQLAlchemy 2 (async)",
        "kind": "orm",
        "models": [
          "relational"
        ],
        "engines": [
          "postgresql",
          "mysql",
          "mariadb"
        ],
        "runtimes": [
          "python"
        ],
        "migrations": {
          "tool": "Alembic",
          "generate": [
            "uv",
            "run",
            "alembic",
            "revision",
            "--autogenerate",
            "-m",
            "<name>"
          ],
          "apply": [
            "uv",
            "run",
            "alembic",
            "upgrade",
            "head"
          ]
        },
        "schema_validation": null,
        "notes": "AsyncSession sobre asyncpg o asyncmy; Alembic trae la plantilla `alembic init -t async`. No corre en Python Workers: SQLAlchemy async necesita greenlet, que ese entorno no tiene.",
        "sources": [
          "https://docs.sqlalchemy.org/en/20/orm/extensions/asyncio.html",
          "https://alembic.sqlalchemy.org/en/latest/tutorial.html",
          "https://alembic.sqlalchemy.org/en/latest/cookbook.html",
          "https://docs.sqlalchemy.org/en/20/dialects/",
          "https://developers.cloudflare.com/hyperdrive/examples/python-workers/"
        ]
      },
      {
        "id": "sqlalchemy-sync",
        "name": "SQLAlchemy 2 (síncrono)",
        "kind": "orm",
        "models": [
          "relational"
        ],
        "engines": [
          "postgresql",
          "mysql",
          "mariadb"
        ],
        "runtimes": [
          "python",
          "python-workers"
        ],
        "migrations": {
          "tool": "Alembic",
          "generate": [
            "uv",
            "run",
            "alembic",
            "revision",
            "--autogenerate",
            "-m",
            "<name>"
          ],
          "apply": [
            "uv",
            "run",
            "alembic",
            "upgrade",
            "head"
          ]
        },
        "schema_validation": null,
        "notes": "En Python Workers es la única variante admitida («only synchronous SQLAlchemy ORMs are supported»), con `compatibility_date` 2026-09-08 o posterior y serializando las operaciones con un `asyncio.Lock`. Hyperdrive probó psycopg y pg8000 en PostgreSQL y pymysql en MySQL. Alembic corre desde CI o local, no desde el Worker.",
        "sources": [
          "https://docs.sqlalchemy.org/en/20/orm/quickstart.html",
          "https://docs.sqlalchemy.org/en/20/dialects/",
          "https://alembic.sqlalchemy.org/en/latest/tutorial.html",
          "https://developers.cloudflare.com/hyperdrive/examples/python-workers/",
          "https://developers.cloudflare.com/workers/languages/python/packages/fastapi/"
        ],
        "drivers": {
          "postgresql": {
            "driver": "psycopg",
            "url": "postgresql+psycopg://app:app_local_only@127.0.0.1:5432/app"
          },
          "mysql": {
            "driver": "pymysql",
            "url": "mysql+pymysql://app:app_local_only@127.0.0.1:3306/app"
          },
          "mariadb": {
            "driver": "pymysql",
            "url": "mysql+pymysql://app:app_local_only@127.0.0.1:3306/app"
          }
        }
      },
      {
        "id": "sqlmodel",
        "name": "SQLModel",
        "kind": "orm",
        "models": [
          "relational"
        ],
        "engines": [
          "postgresql",
          "mysql",
          "mariadb"
        ],
        "runtimes": [
          "python"
        ],
        "migrations": {
          "tool": "Alembic",
          "generate": [
            "uv",
            "run",
            "alembic",
            "revision",
            "--autogenerate",
            "-m",
            "<name>"
          ],
          "apply": [
            "uv",
            "run",
            "alembic",
            "upgrade",
            "head"
          ]
        },
        "schema_validation": null,
        "notes": "Basado en SQLAlchemy y Pydantic, del mismo autor que FastAPI; admite las bases de SQLAlchemy. FastAPI indica usar Alembic directamente para las migraciones.",
        "sources": [
          "https://sqlmodel.tiangolo.com/",
          "https://fastapi.tiangolo.com/tutorial/sql-databases/",
          "https://alembic.sqlalchemy.org/en/latest/tutorial.html"
        ],
        "drivers": {
          "postgresql": {
            "driver": "psycopg",
            "url": "postgresql+psycopg://app:app_local_only@127.0.0.1:5432/app"
          },
          "mysql": {
            "driver": "pymysql",
            "url": "mysql+pymysql://app:app_local_only@127.0.0.1:3306/app"
          },
          "mariadb": {
            "driver": "pymysql",
            "url": "mysql+pymysql://app:app_local_only@127.0.0.1:3306/app"
          }
        }
      },
      {
        "id": "pymongo-async",
        "name": "PyMongo Async",
        "kind": "driver",
        "models": [
          "document"
        ],
        "engines": [
          "mongodb"
        ],
        "runtimes": [
          "python"
        ],
        "migrations": null,
        "schema_validation": "Validación de esquema de MongoDB: reglas `$jsonSchema` en cada colección, declaradas en el repositorio.",
        "notes": "Driver oficial; su API async sustituye a Motor, que MongoDB deprecó el 14 de mayo de 2026.",
        "sources": [
          "https://www.mongodb.com/docs/languages/python/pymongo-driver/current/",
          "https://www.mongodb.com/docs/languages/python/pymongo-driver/current/reference/migration/",
          "https://www.mongodb.com/docs/manual/core/schema-validation/"
        ]
      },
      {
        "id": "beanie",
        "name": "Beanie",
        "kind": "odm",
        "models": [
          "document"
        ],
        "engines": [
          "mongodb"
        ],
        "runtimes": [
          "python"
        ],
        "migrations": null,
        "schema_validation": "Modelos Pydantic: la forma se valida en la aplicación al leer y escribir.",
        "notes": "ODM asíncrono sobre PyMongo; incluye migraciones de datos y de esquema.",
        "sources": [
          "https://beanie-odm.dev/",
          "https://github.com/BeanieODM/beanie"
        ]
      }
    ]
  }
}
