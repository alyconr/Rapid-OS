{
  "schema_version": 1,
  "id": "dotnet-aspnetcore",
  "component": "backend",
  "covers": [
    "backend"
  ],
  "summary": "API en C# con ASP.NET Core: Minimal APIs o controladores, Entity Framework Core y herramientas de Microsoft.",
  "language": "C#",
  "fits": [
    "APIs empresariales en organizaciones con ecosistema Microsoft",
    "servicios que se despliegan en Azure o en contenedores",
    "equipos con experiencia en C#"
  ],
  "avoid_if": [
    "el equipo no usa C#",
    "se necesita un binario mínimo sin runtime administrado",
    "un sitio de documentación es el objetivo"
  ],
  "suggested_services": [
    "database:postgresql"
  ],
  "package_manager": "nuget",
  "default_test_command": [
    "dotnet",
    "test"
  ],
  "test_commands": {
    "root": [
      "dotnet",
      "test"
    ],
    "subdir": [
      "dotnet",
      "test",
      "{root}"
    ]
  },
  "gitignore": [
    "bin/",
    "obj/",
    ".vs/",
    "*.user",
    ".env"
  ],
  "architecture": "dotnet-aspnetcore",
  "factors": {
    "performance": "alto: la documentación lo describe como framework de alto rendimiento con servidor Kestrel",
    "memory_footprint": "medio; Native AOT puede requerir menos memoria que la ejecución con JIT",
    "cold_start": "medio con JIT; Native AOT reduce el tiempo de arranque",
    "concurrency_model": "async/await sobre el grupo de hilos de .NET",
    "typing": "tipado estático (C#)",
    "productivity": "alto: Minimal APIs, inyección de dependencias, EF Core y herramientas integradas",
    "learning_curve": "media: C# y un framework grande",
    "maintainability": "alta: tipado estático, proyectos por capa y pruebas arquitectónicas con NetArchTest",
    "ecosystem_maturity": "alto: .NET 10 es LTS con tres años de soporte; NuGet y EF Core maduros",
    "hiring_pool": "alto: C# lo usa el 29,9 % y ASP.NET Core el 21,3 % de los desarrolladores profesionales (Stack Overflow 2025)",
    "hosting_fit": "containers, PaaS"
  },
  "sources": {
    "performance": [
      "https://learn.microsoft.com/en-us/aspnet/core/introduction-to-aspnet-core"
    ],
    "memory_footprint": [
      "https://learn.microsoft.com/en-us/aspnet/core/fundamentals/native-aot"
    ],
    "cold_start": [
      "https://learn.microsoft.com/en-us/aspnet/core/fundamentals/native-aot"
    ],
    "concurrency_model": [
      "https://learn.microsoft.com/en-us/aspnet/core/introduction-to-aspnet-core"
    ],
    "typing": [
      "https://learn.microsoft.com/en-us/aspnet/core/introduction-to-aspnet-core"
    ],
    "productivity": [
      "https://learn.microsoft.com/en-us/aspnet/core/introduction-to-aspnet-core",
      "https://learn.microsoft.com/en-us/ef/core/"
    ],
    "learning_curve": [
      "https://learn.microsoft.com/en-us/aspnet/core/introduction-to-aspnet-core"
    ],
    "maintainability": [
      "https://github.com/BenMorris/NetArchTest",
      "https://learn.microsoft.com/en-us/aspnet/core/test/integration-tests"
    ],
    "ecosystem_maturity": [
      "https://dotnet.microsoft.com/en-us/platform/support/policy/dotnet-core",
      "https://learn.microsoft.com/en-us/ef/core/"
    ],
    "hiring_pool": [
      "https://survey.stackoverflow.co/2025/technology"
    ],
    "hosting_fit": [
      "https://learn.microsoft.com/en-us/aspnet/core/fundamentals/native-aot"
    ]
  },
  "supported_services": {
    "postgresql": {
      "driver": "Npgsql",
      "url": "Host=127.0.0.1;Port=5432;Username=app;Password=app_local_only;Database=app"
    },
    "mysql": {
      "driver": "MySqlConnector",
      "url": "Server=127.0.0.1;Port=3306;User ID=app;Password=app_local_only;Database=app"
    },
    "mariadb": {
      "driver": "MySqlConnector",
      "url": "Server=127.0.0.1;Port=3306;User ID=app;Password=app_local_only;Database=app"
    },
    "mongodb": {
      "driver": "MongoDB.Driver",
      "url": "mongodb://app:app_local_only@127.0.0.1:27017/app?authSource=admin"
    },
    "redis": {
      "driver": "StackExchange.Redis",
      "url": "127.0.0.1:6379"
    },
    "rabbitmq": {
      "driver": "RabbitMQ.Client",
      "url": "amqp://app:app_local_only@127.0.0.1:5672/"
    },
    "kafka": {
      "driver": "Confluent.Kafka",
      "url": "localhost:9092"
    }
  },
  "data_access": {
    "default": {
      "relational": "ef-core",
      "document": "mongodb-csharp-driver"
    },
    "options": [
      {
        "id": "ef-core",
        "name": "Entity Framework Core",
        "kind": "orm",
        "models": [
          "relational"
        ],
        "engines": [
          "postgresql",
          "mysql",
          "mariadb"
        ],
        "runtimes": [
          "dotnet"
        ],
        "migrations": {
          "tool": "dotnet ef",
          "generate": [
            "dotnet",
            "ef",
            "migrations",
            "add",
            "<name>"
          ],
          "apply": [
            "dotnet",
            "ef",
            "database",
            "update"
          ]
        },
        "schema_validation": null,
        "notes": "PostgreSQL con Npgsql; MySQL y MariaDB con el proveedor Pomelo.",
        "sources": [
          "https://learn.microsoft.com/en-us/ef/core/managing-schemas/migrations/",
          "https://learn.microsoft.com/en-us/ef/core/providers/"
        ]
      },
      {
        "id": "dapper",
        "name": "Dapper",
        "kind": "driver",
        "models": [
          "relational"
        ],
        "engines": [
          "postgresql",
          "mysql",
          "mariadb"
        ],
        "runtimes": [
          "dotnet"
        ],
        "migrations": null,
        "schema_validation": null,
        "notes": "Mapeador de objetos sobre ADO.NET; escribes el SQL y no incluye migraciones: decide la herramienta en el documento de datos.",
        "sources": [
          "https://github.com/DapperLib/Dapper"
        ]
      },
      {
        "id": "mongodb-csharp-driver",
        "name": "Driver oficial de MongoDB para .NET",
        "kind": "driver",
        "models": [
          "document"
        ],
        "engines": [
          "mongodb"
        ],
        "runtimes": [
          "dotnet"
        ],
        "migrations": null,
        "schema_validation": "Validación de esquema de MongoDB: reglas `$jsonSchema` en cada colección, declaradas en el repositorio.",
        "notes": "Sin capa de modelos de EF Core: la forma la fija el código y la validación de la colección.",
        "sources": [
          "https://www.mongodb.com/docs/drivers/csharp/current/",
          "https://www.mongodb.com/docs/manual/core/schema-validation/"
        ]
      },
      {
        "id": "mongodb-ef-core",
        "name": "Proveedor de EF Core para MongoDB",
        "kind": "orm",
        "models": [
          "document"
        ],
        "engines": [
          "mongodb"
        ],
        "runtimes": [
          "dotnet"
        ],
        "migrations": null,
        "schema_validation": "Validación de esquema de MongoDB: reglas `$jsonSchema` en cada colección, declaradas en el repositorio.",
        "notes": "Proveedor oficial, en desarrollo activo: no soporta migraciones, claves foráneas ni proyecciones `Select`.",
        "sources": [
          "https://www.mongodb.com/docs/entity-framework/current/",
          "https://www.mongodb.com/docs/entity-framework/current/limitations/",
          "https://www.mongodb.com/docs/manual/core/schema-validation/"
        ]
      }
    ]
  }
}
