{
  "schema_version": 1,
  "id": "node-nestjs",
  "component": "backend",
  "covers": [
    "backend"
  ],
  "summary": "API en TypeScript con NestJS: módulos, inyección de dependencias y decoradores.",
  "language": "TypeScript",
  "fits": [
    "APIs grandes con equipos que valoran una estructura impuesta por el framework",
    "equipos con experiencia en Angular",
    "monolitos modulares en TypeScript"
  ],
  "avoid_if": [
    "el equipo prefiere pocas abstracciones y arranque mínimo",
    "el equipo no usa TypeScript",
    "un sitio de documentación es el objetivo"
  ],
  "suggested_services": [
    "database:postgresql"
  ],
  "package_manager": "pnpm",
  "default_test_command": [
    "pnpm",
    "test"
  ],
  "test_commands": {
    "root": [
      "pnpm",
      "test"
    ],
    "subdir": [
      "pnpm",
      "--dir",
      "{root}",
      "test"
    ]
  },
  "gitignore": [
    "node_modules/",
    "dist/",
    "coverage/",
    ".env"
  ],
  "architecture": "node-nestjs",
  "factors": {
    "performance": "medio a alto en E/S: Node.js (V8) con Express por defecto o Fastify opcional",
    "memory_footprint": "medio: proceso Node.js con el contenedor de inyección de dependencias cargado",
    "cold_start": "medio: la documentación aconseja empaquetar con webpack y cargar módulos de forma perezosa en serverless",
    "concurrency_model": "bucle de eventos de un hilo con E/S asíncrona; worker threads para CPU",
    "typing": "TypeScript de primera clase; los proyectos nuevos activan el modo estricto",
    "productivity": "alto: CLI, módulos, pipes de validación y pruebas integrados",
    "learning_curve": "media: decoradores, módulos e inyección de dependencias",
    "maintainability": "alta: un módulo encapsula sus providers y solo exporta su API pública",
    "ecosystem_maturity": "alto: Node.js y npm; integraciones oficiales con TypeORM, Drizzle, Mongoose y otros",
    "hiring_pool": "medio: TypeScript lo usa el 48,8 % de los desarrolladores profesionales y NestJS el 7,4 % (Stack Overflow 2025)",
    "hosting_fit": "containers, PaaS, serverless"
  },
  "sources": {
    "performance": [
      "https://docs.nestjs.com/"
    ],
    "memory_footprint": [
      "https://docs.nestjs.com/"
    ],
    "cold_start": [
      "https://docs.nestjs.com/faq/serverless"
    ],
    "concurrency_model": [
      "https://nodejs.org/en/learn/asynchronous-work/event-loop-timers-and-nexttick"
    ],
    "typing": [
      "https://docs.nestjs.com/",
      "https://docs.nestjs.com/first-steps"
    ],
    "productivity": [
      "https://docs.nestjs.com/first-steps"
    ],
    "learning_curve": [
      "https://docs.nestjs.com/modules"
    ],
    "maintainability": [
      "https://docs.nestjs.com/modules"
    ],
    "ecosystem_maturity": [
      "https://docs.nestjs.com/techniques/database"
    ],
    "hiring_pool": [
      "https://survey.stackoverflow.co/2025/technology"
    ],
    "hosting_fit": [
      "https://docs.nestjs.com/faq/serverless"
    ]
  },
  "supported_services": {
    "postgresql": {
      "driver": "pg",
      "url": "postgresql://app:app_local_only@127.0.0.1:5432/app"
    },
    "mysql": {
      "driver": "mysql2",
      "url": "mysql://app:app_local_only@127.0.0.1:3306/app"
    },
    "mariadb": {
      "driver": "mariadb",
      "url": "mariadb://app:app_local_only@127.0.0.1:3306/app"
    },
    "mongodb": {
      "driver": "mongodb",
      "url": "mongodb://app:app_local_only@127.0.0.1:27017/app?authSource=admin"
    },
    "redis": {
      "driver": "redis",
      "url": "redis://127.0.0.1:6379/0"
    },
    "valkey": {
      "driver": "iovalkey",
      "url": "redis://127.0.0.1:6379/0"
    },
    "rabbitmq": {
      "driver": "amqplib",
      "url": "amqp://app:app_local_only@127.0.0.1:5672/"
    },
    "kafka": {
      "driver": "kafkajs",
      "url": "localhost:9092"
    }
  },
  "data_access": {
    "default": {
      "relational": "typeorm",
      "document": "mongoose"
    },
    "options": [
      {
        "id": "typeorm",
        "name": "TypeORM",
        "kind": "orm",
        "models": [
          "relational"
        ],
        "engines": [
          "postgresql",
          "mysql",
          "mariadb"
        ],
        "runtimes": [
          "node"
        ],
        "migrations": {
          "tool": "TypeORM CLI",
          "generate": [
            "pnpm",
            "typeorm-ts-node-commonjs",
            "migration:generate",
            "-d",
            "<datasource>",
            "<path>"
          ],
          "apply": [
            "pnpm",
            "typeorm-ts-node-commonjs",
            "migration:run",
            "-d",
            "<datasource>"
          ]
        },
        "schema_validation": null,
        "notes": "NestJS trae el paquete `@nestjs/typeorm`. `migration:run` trabaja sobre `.js`: con TypeScript usa el ejecutable `typeorm-ts-node-commonjs` (o `typeorm-ts-node-esm` en ESM).",
        "sources": [
          "https://typeorm.io/",
          "https://typeorm.io/docs/migrations/generating",
          "https://typeorm.io/docs/migrations/executing",
          "https://docs.nestjs.com/techniques/database"
        ]
      },
      {
        "id": "drizzle",
        "name": "Drizzle ORM",
        "kind": "orm",
        "models": [
          "relational"
        ],
        "engines": [
          "postgresql",
          "mysql"
        ],
        "runtimes": [
          "node"
        ],
        "migrations": {
          "tool": "drizzle-kit",
          "generate": [
            "pnpm",
            "drizzle-kit",
            "generate"
          ],
          "apply": [
            "pnpm",
            "drizzle-kit",
            "migrate"
          ]
        },
        "schema_validation": null,
        "notes": "ORM de TypeScript sin motor propio: el esquema es código y drizzle-kit genera migraciones SQL.",
        "sources": [
          "https://orm.drizzle.team/docs/overview",
          "https://orm.drizzle.team/docs/drizzle-kit-generate",
          "https://orm.drizzle.team/docs/drizzle-kit-migrate"
        ]
      },
      {
        "id": "prisma",
        "name": "Prisma ORM 7",
        "kind": "orm",
        "models": [
          "relational"
        ],
        "engines": [
          "postgresql",
          "mysql",
          "mariadb"
        ],
        "runtimes": [
          "node"
        ],
        "migrations": {
          "tool": "prisma migrate",
          "generate": [
            "pnpm",
            "prisma",
            "migrate",
            "dev",
            "--name",
            "<name>"
          ],
          "apply": [
            "pnpm",
            "prisma",
            "migrate",
            "deploy"
          ]
        },
        "schema_validation": null,
        "notes": "Fija Prisma ORM 7: el tag `latest` de npm apunta a la prerelease 8 (8.0.0-rc), que cambia estos comandos por `prisma migration plan` y `prisma db migrate` y aún no da soporte estable a MySQL ni a MariaDB. Prisma 7 tampoco admite MongoDB (usa `mongodb` o Mongoose). `migrate dev` nunca se ejecuta en producción. NestJS lo documenta en su receta de Prisma, sin paquete propio.",
        "sources": [
          "https://www.prisma.io/docs/orm/v7/prisma-migrate/getting-started",
          "https://www.prisma.io/docs/orm/v7/prisma-migrate/workflows/development-and-production",
          "https://www.prisma.io/docs/orm/v7/core-concepts/supported-databases",
          "https://www.prisma.io/docs/orm/coming-from-prisma-orm-7",
          "https://docs.nestjs.com/recipes/prisma"
        ]
      },
      {
        "id": "kysely",
        "name": "Kysely",
        "kind": "query-builder",
        "models": [
          "relational"
        ],
        "engines": [
          "postgresql",
          "mysql"
        ],
        "runtimes": [
          "node"
        ],
        "migrations": {
          "tool": "kysely-ctl",
          "generate": [
            "pnpm",
            "kysely",
            "migrate",
            "make",
            "<name>"
          ],
          "apply": [
            "pnpm",
            "kysely",
            "migrate",
            "latest"
          ]
        },
        "schema_validation": null,
        "notes": "Query builder de SQL con tipos, no un ORM: las migraciones se escriben a mano y corren con su `Migrator` o con la CLI opcional kysely-ctl (`kysely init` crea su configuración). MariaDB solo tiene dialecto de terceros: fuera.",
        "sources": [
          "https://kysely.dev/docs/intro",
          "https://kysely.dev/docs/migrations",
          "https://kysely.dev/docs/dialects",
          "https://github.com/kysely-org/kysely-ctl"
        ]
      },
      {
        "id": "mongoose",
        "name": "Mongoose",
        "kind": "odm",
        "models": [
          "document"
        ],
        "engines": [
          "mongodb"
        ],
        "runtimes": [
          "node"
        ],
        "migrations": null,
        "schema_validation": "Esquemas de Mongoose: los validadores se declaran en cada `SchemaType` y corren en la aplicación.",
        "notes": "NestJS trae el paquete `@nestjs/mongoose`. Modela cada colección con un esquema.",
        "sources": [
          "https://mongoosejs.com/docs/",
          "https://mongoosejs.com/docs/validation.html",
          "https://docs.nestjs.com/techniques/mongodb"
        ]
      },
      {
        "id": "mongodb-driver",
        "name": "Driver oficial de MongoDB para Node.js",
        "kind": "driver",
        "models": [
          "document"
        ],
        "engines": [
          "mongodb"
        ],
        "runtimes": [
          "node"
        ],
        "migrations": null,
        "schema_validation": "Validación de esquema de MongoDB: reglas `$jsonSchema` en cada colección, declaradas en el repositorio.",
        "notes": "Sin capa de modelos: la forma de cada documento la fija el código y la validación de la colección.",
        "sources": [
          "https://www.mongodb.com/docs/drivers/node/current/",
          "https://www.mongodb.com/docs/manual/core/schema-validation/"
        ]
      }
    ]
  }
}
