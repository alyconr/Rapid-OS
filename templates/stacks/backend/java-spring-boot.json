{
  "schema_version": 1,
  "id": "java-spring-boot",
  "component": "backend",
  "covers": [
    "backend"
  ],
  "summary": "Sistemas empresariales en Java con Spring Boot y Spring Modulith.",
  "language": "Java",
  "fits": [
    "sistemas empresariales con equipos grandes",
    "monolitos modulares con Spring Modulith",
    "equipos con experiencia en Java y Spring"
  ],
  "avoid_if": [
    "se necesita arranque mínimo y poca memoria sin imagen nativa",
    "el equipo no usa Java",
    "un sitio de documentación es el objetivo"
  ],
  "suggested_services": [
    "database:postgresql"
  ],
  "package_manager": "maven",
  "default_test_command": [
    "./mvnw",
    "test"
  ],
  "test_commands": {
    "root": [
      "./mvnw",
      "test"
    ],
    "subdir": [
      "./mvnw",
      "-f",
      "{root}/pom.xml",
      "test"
    ]
  },
  "gitignore": [
    "target/",
    ".idea/",
    "*.iml",
    ".env"
  ],
  "architecture": "java-spring-boot",
  "factors": {
    "performance": "alto en estado estable: JVM con optimización en ejecución",
    "memory_footprint": "alto frente a binarios nativos: JVM; la imagen nativa con GraalVM la reduce",
    "cold_start": "alto con JVM; la imagen nativa con GraalVM lo reduce",
    "concurrency_model": "hilos de la plataforma JVM; los hilos virtuales están disponibles desde Java 21",
    "typing": "tipado estático (Java)",
    "productivity": "alto: starters y autoconfiguración para datos, mensajería y seguridad",
    "learning_curve": "media: Java y un ecosistema Spring extenso",
    "maintainability": "alta: Spring Modulith verifica que los módulos solo accedan a los paquetes de API de otros módulos",
    "ecosystem_maturity": "muy alto: Spring Boot 4.1 con versiones de soporte publicadas y starters para datos y mensajería",
    "hiring_pool": "alto: Java lo usa el 29,6 % y Spring Boot el 15,6 % de los desarrolladores profesionales (Stack Overflow 2025)",
    "hosting_fit": "containers, PaaS"
  },
  "sources": {
    "performance": [
      "https://spring.io/projects/spring-boot"
    ],
    "memory_footprint": [
      "https://docs.spring.io/spring-boot/system-requirements.html"
    ],
    "cold_start": [
      "https://docs.spring.io/spring-boot/system-requirements.html"
    ],
    "concurrency_model": [
      "https://docs.spring.io/spring-boot/reference/"
    ],
    "typing": [
      "https://docs.spring.io/spring-boot/system-requirements.html"
    ],
    "productivity": [
      "https://docs.spring.io/spring-boot/reference/"
    ],
    "learning_curve": [
      "https://docs.spring.io/spring-boot/reference/"
    ],
    "maintainability": [
      "https://docs.spring.io/spring-modulith/reference/",
      "https://docs.spring.io/spring-modulith/reference/verification.html"
    ],
    "ecosystem_maturity": [
      "https://spring.io/projects/spring-boot",
      "https://docs.spring.io/spring-boot/system-requirements.html"
    ],
    "hiring_pool": [
      "https://survey.stackoverflow.co/2025/technology"
    ],
    "hosting_fit": [
      "https://docs.spring.io/spring-boot/reference/"
    ]
