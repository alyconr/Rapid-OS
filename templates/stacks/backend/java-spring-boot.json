  "supported_services": {
    "postgresql": {
      "driver": "pgjdbc",
      "url": "jdbc:postgresql://127.0.0.1:5432/app"
    },
    "mysql": {
      "driver": "mysql-connector-j",
      "url": "jdbc:mysql://127.0.0.1:3306/app"
    },
    "mariadb": {
      "driver": "mariadb-java-client",
      "url": "jdbc:mariadb://127.0.0.1:3306/app"
    },
    "mongodb": {
      "driver": "spring-boot-starter-data-mongodb",
      "url": "mongodb://app:app_local_only@127.0.0.1:27017/app?authSource=admin"
    },
    "redis": {
      "driver": "spring-boot-starter-data-redis",
      "url": "redis://127.0.0.1:6379/0"
    },
    "rabbitmq": {
      "driver": "spring-boot-starter-amqp",
      "url": "amqp://app:app_local_only@127.0.0.1:5672/"
    },
    "kafka": {
      "driver": "spring-kafka",
      "url": "localhost:9092"
    }
  },
  "data_access": {
    "default": {
      "relational": "spring-data-jpa",
      "document": "spring-data-mongodb"
    },
    "options": [
      {
        "id": "spring-data-jpa",
        "name": "Spring Data JPA (Hibernate)",
        "kind": "orm",
        "models": [
          "relational"
        ],
        "engines": [
          "postgresql",
          "mysql",
          "mariadb"
        ],
        "runtimes": [
          "jvm"
        ],
        "migrations": {
          "tool": "Flyway",
          "generate": null,
          "apply": [
            "flyway",
            "migrate"
          ]
        },
        "schema_validation": null,
        "notes": "Repositorios JPA sobre Hibernate. Migraciones SQL versionadas en `db/migration`, que Spring Boot aplica al arrancar con `spring-boot-starter-flyway`; Liquibase (`liquibase update`) es la alternativa.",
        "sources": [
          "https://spring.io/projects/spring-data-jpa",
          "https://docs.spring.io/spring-boot/reference/data/sql.html",
          "https://hibernate.org/orm/",
          "https://docs.spring.io/spring-boot/how-to/data-initialization.html",
          "https://documentation.red-gate.com/flyway/flyway-concepts/migrations",
          "https://documentation.red-gate.com/fd/migrate-277578887.html",
          "https://docs.liquibase.com/commands/update/update.html"
        ]
      },
      {
        "id": "spring-data-jdbc",
        "name": "Spring Data JDBC",
        "kind": "orm",
        "models": [
          "relational"
        ],
        "engines": [
          "postgresql",
          "mysql",
          "mariadb"
        ],
        "runtimes": [
          "jvm"
        ],
        "migrations": {
          "tool": "Flyway",
          "generate": null,
          "apply": [
            "flyway",
            "migrate"
          ]
        },
        "schema_validation": null,
        "notes": "Repositorios sobre JDBC, sin la capa de JPA. Migraciones SQL versionadas en `db/migration`, que Spring Boot aplica al arrancar con `spring-boot-starter-flyway`; Liquibase (`liquibase update`) es la alternativa.",
        "sources": [
          "https://spring.io/projects/spring-data-relational",
          "https://docs.spring.io/spring-data/relational/reference/jdbc/getting-started.html",
          "https://docs.spring.io/spring-boot/how-to/data-initialization.html",
