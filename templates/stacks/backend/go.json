{
  "schema_version": 1,
  "id": "go",
  "component": "backend",
  "covers": [
    "backend"
  ],
  "summary": "Servicios HTTP en Go con la biblioteca estándar: binario autocontenido y concurrencia con goroutines.",
  "language": "Go",
  "fits": [
    "servicios de red con muchas conexiones concurrentes",
    "APIs que se despliegan como un binario en contenedores",
    "equipos que valoran un lenguaje pequeño y herramientas estándar"
  ],
  "avoid_if": [
    "el equipo quiere un framework con ORM y administración incluidos",
    "el equipo no conoce Go y el plazo es corto",
    "un sitio de documentación es el objetivo"
  ],
  "suggested_services": [
    "database:postgresql"
  ],
  "package_manager": "go modules",
  "default_test_command": [
    "go",
    "test",
    "./..."
  ],
  "test_commands": {
    "root": [
      "go",
      "test",
      "./..."
    ],
    "subdir": [
      "go",
      "-C",
      "{root}",
      "test",
      "./..."
    ]
  },
  "gitignore": [
    "bin/",
    "*.test",
    "coverage.out",
    ".env"
  ],
  "architecture": "go",
  "factors": {
    "performance": "alto: lenguaje compilado a código nativo con servidor HTTP en la biblioteca estándar",
    "memory_footprint": "bajo a medio: recolector de basura y goroutines ligeras",
    "cold_start": "bajo: un servidor suele ser un binario autocontenido, sin runtime externo",
    "concurrency_model": "goroutines y canales: comunicar para compartir memoria, no compartir memoria para comunicar",
    "typing": "tipado estático",
    "productivity": "medio: biblioteca estándar amplia y herramientas integradas, con más código explícito que en frameworks con convenciones",
    "learning_curve": "baja a media: lenguaje pequeño; la gestión explícita de errores y la concurrencia requieren práctica",
    "maintainability": "alta: gofmt unifica el formato y internal/ impide importaciones externas a un módulo",
    "ecosystem_maturity": "alto en servicios de red y herramientas de nube; menos frameworks completos que Java o .NET",
    "hiring_pool": "medio: Go lo usa el 17,4 % de los desarrolladores profesionales (Stack Overflow 2025)",
    "hosting_fit": "containers, PaaS"
  },
  "sources": {
    "performance": [
      "https://pkg.go.dev/net/http"
    ],
    "memory_footprint": [
      "https://go.dev/doc/effective_go"
    ],
    "cold_start": [
      "https://go.dev/doc/modules/layout"
    ],
    "concurrency_model": [
      "https://go.dev/doc/effective_go"
    ],
    "typing": [
      "https://go.dev/ref/spec"
    ],
    "productivity": [
      "https://go.dev/doc/tutorial/add-a-test",
      "https://go.dev/doc/modules/managing-dependencies"
    ],
    "learning_curve": [
      "https://go.dev/doc/effective_go"
    ],
    "maintainability": [
      "https://go.dev/doc/modules/layout",
      "https://go.dev/doc/effective_go"
    ],
    "ecosystem_maturity": [
      "https://go.dev/doc/security/vuln/",
      "https://go.dev/doc/devel/release"
    ],
    "hiring_pool": [
      "https://survey.stackoverflow.co/2025/technology"
    ],
    "hosting_fit": [
      "https://go.dev/doc/modules/layout"
    ]
  },
  "supported_services": {
    "postgresql": {
      "driver": "pgx",
      "url": "postgres://app:app_local_only@127.0.0.1:5432/app"
    },
    "mysql": {
      "driver": "go-sql-driver/mysql",
      "url": "app:app_local_only@tcp(127.0.0.1:3306)/app"
    },
    "mariadb": {
      "driver": "go-sql-driver/mysql",
      "url": "app:app_local_only@tcp(127.0.0.1:3306)/app"
    },
    "mongodb": {
      "driver": "mongo-driver/v2",
      "url": "mongodb://app:app_local_only@127.0.0.1:27017/app?authSource=admin"
    },
    "redis": {
      "driver": "go-redis",
      "url": "redis://127.0.0.1:6379/0"
    },
    "valkey": {
      "driver": "valkey-go",
      "url": "redis://127.0.0.1:6379/0"
    },
    "rabbitmq": {
      "driver": "amqp091-go",
      "url": "amqp://app:app_local_only@127.0.0.1:5672/"
    },
    "kafka": {
      "driver": "franz-go",
      "url": "localhost:9092"
    }
  },
  "data_access": {
    "default": {
      "relational": "pgx-sqlc",
      "document": "mongo-go-driver"
    },
    "options": [
      {
        "id": "pgx-sqlc",
        "name": "pgx + sqlc",
        "kind": "driver",
        "models": [
          "relational"
        ],
        "engines": [
          "postgresql"
        ],
        "runtimes": [
          "go"
        ],
        "migrations": {
          "tool": "goose",
          "generate": [
            "goose",
            "create",
            "<name>",
            "sql"
          ],
          "apply": [
            "goose",
            "up"
          ]
        },
        "schema_validation": null,
        "notes": "pgx es el driver de PostgreSQL y sqlc genera código con tipos desde el SQL. Migraciones con goose (`GOOSE_DRIVER` y `GOOSE_DBSTRING` dan el motor y la conexión); golang-migrate es la alternativa.",
        "sources": [
          "https://github.com/jackc/pgx",
          "https://docs.sqlc.dev/en/latest/index.html",
          "https://docs.sqlc.dev/en/latest/howto/ddl.html",
          "https://github.com/pressly/goose",
          "https://github.com/golang-migrate/migrate"
        ]
      },
      {
        "id": "gorm",
        "name": "GORM",
        "kind": "orm",
        "models": [
          "relational"
        ],
        "engines": [
          "postgresql",
          "mysql"
        ],
        "runtimes": [
          "go"
        ],
        "migrations": {
          "tool": "goose",
          "generate": [
            "goose",
            "create",
            "<name>",
            "sql"
          ],
          "apply": [
            "goose",
            "up"
          ]
        },
        "schema_validation": null,
        "notes": "ORM completo. `AutoMigrate` no borra columnas ni versiona: usa migraciones versionadas. Migraciones con goose (`GOOSE_DRIVER` y `GOOSE_DBSTRING` dan el motor y la conexión); golang-migrate es la alternativa.",
        "sources": [
          "https://gorm.io/docs/",
          "https://gorm.io/docs/connecting_to_the_database.html",
          "https://gorm.io/docs/migration.html",
          "https://github.com/pressly/goose",
          "https://github.com/golang-migrate/migrate"
        ]
      },
      {
        "id": "ent",
        "name": "ent",
        "kind": "orm",
        "models": [
          "relational"
        ],
        "engines": [
          "postgresql",
          "mysql",
          "mariadb"
        ],
        "runtimes": [
          "go"
        ],
        "migrations": {
          "tool": "Atlas",
          "generate": [
            "atlas",
            "migrate",
            "diff",
            "<name>",
            "--dir",
            "file://ent/migrate/migrations",
            "--to",
            "ent://ent/schema",
            "--dev-url",
            "<dev-url>"
          ],
          "apply": [
            "atlas",
            "migrate",
            "apply",
            "--dir",
            "file://ent/migrate/migrations",
            "--url",
            "<url>"
          ]
        },
        "schema_validation": null,
        "notes": "Framework de entidades cuyo esquema es código Go; sus migraciones versionadas se generan con Atlas.",
        "sources": [
          "https://entgo.io/docs/getting-started",
          "https://entgo.io/docs/versioned-migrations"
        ]
      },
      {
        "id": "mongo-go-driver",
        "name": "Driver oficial de MongoDB para Go",
        "kind": "driver",
        "models": [
          "document"
        ],
        "engines": [
          "mongodb"
        ],
        "runtimes": [
          "go"
        ],
        "migrations": null,
        "schema_validation": "Validación de esquema de MongoDB: reglas `$jsonSchema` en cada colección, declaradas en el repositorio.",
        "notes": "Sin capa de modelos: la forma de cada documento la fija el código y la validación de la colección.",
        "sources": [
          "https://www.mongodb.com/docs/drivers/go/current/",
          "https://www.mongodb.com/docs/manual/core/schema-validation/"
        ]
      }
    ]
  }
}
